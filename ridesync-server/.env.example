# RideSync server — copy to .env and fill in. Never commit a real .env.
# Local dev works with everything below unset (in-memory mode, dev JWT secret).
PORT=4000
# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Leave empty to run in-memory (seed data only, nothing is persisted).
MONGODB_URI=
# Long random secret for signing JWTs. Required in production; a dev-only
# fallback is used locally and logs a warning.
JWT_SECRET=
# Comma-separated allowed browser origins for REST + Socket.IO.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://ridesync-ten.vercel.app
CLIENT_URL=http://localhost:5173
